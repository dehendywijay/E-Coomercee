generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum cekStore{
  YA
  NO
}

enum jenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

model User{
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  refreshToken String?

  profile   Profile?
  store     Store?
}

model Profile {
  id        Int      @id @default(autoincrement())
  gender   jenisKelamin?  
  phone     String?  
  address   String? 
  birthDate DateTime? 
  
  userId    Int      @unique 
  
  user      User     @relation(fields: [userId], references: [id])
}

model Store {
  id          Int      @id @default(autoincrement())
  buka        cekStore? @default(NO)
  name        String
  location    String?
  isOfficial  Boolean  @default(false)

  userId      Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  products    Product[]
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  imageSrc          String
  stock             Int
  originalPrice     Float?
  discountPercentage Float?
  rating            Float
  salesCount        String
  bonusText         String?
  location          String
  description       String?
  

  storeId           Int   @unique
  store             Store     @relation(fields: [storeId], references: [id])
}





